---
import '../styles/themes/tokens.css';
import '../styles/themes/normal.css';
import '../styles/themes/reader.css';
import 'highlight.js/styles/github.css';
import ThemeToggle from '../components/ThemeToggle.vue';
import PillNav from '../components/PillNav.vue';
import MobileHeader from '../components/MobileHeader.vue';
import { getPublicSettings, type ThemeConfig } from '../lib/api';
import { TECH_LOGOS } from '../lib/techLogos';

interface Props {
  title?: string;
  description?: string;
  /** full = 侧栏布局（首页/列表页）；article = 窄列竖排品牌 + 右侧目录（文章页） */
  layout?: 'full' | 'article';
  /** 社交分享 / og 用图（相对路径或绝对 URL），缺省回退站点 banner */
  image?: string;
}

const { title = '', description = '', layout = 'full', image } = Astro.props;
// 服务端读取默认主题与导航菜单，直接注入 <html data-theme>，避免闪烁
// 优先复用 middleware 每请求一次的 settings，避免重复 HTTP 往返
const settings = Astro.locals.settings ?? (await getPublicSettings());
const siteName = settings.siteName || '我的博客';
const defaultTheme = settings.theme || 'normal';
const year = new Date().getFullYear();
// 双主题各自导航菜单（label + url；http 开头外链新窗口打开）
const navItemsNormal = (settings.navMenuNormal ?? []).filter((i) => i.label && i.url);
const navItemsReader = (settings.navMenuReader ?? []).filter((i) => i.label && i.url);
// 当前路径（用于导航高亮）
const path = Astro.url.pathname;
const isActive = (url: string) =>
  url === '/' ? path === '/' : path === url || (url !== '/' && path.startsWith(url));

// 后台主题配置 → CSS 变量覆盖（两套都注入，切换主题时同样生效；:root 提权压制打包 CSS）
function themeStyleBlock(theme: 'normal' | 'reader', cfg: ThemeConfig): string {
  const vars: string[] = [];
  if (cfg.bg) vars.push(`--color-bg:${cfg.bg}`);
  if (cfg.text) vars.push(`--color-text:${cfg.text}`);
  if (cfg.muted) vars.push(`--color-text-muted:${cfg.muted}`);
  if (cfg.primary) vars.push(`--color-primary:${cfg.primary}`);
  if (cfg.border) vars.push(`--color-border:${cfg.border}`);
  if (cfg.fontSize) vars.push(`--font-size:${cfg.fontSize}px`);
  if (!vars.length) return '';
  return `<style>:root[data-theme='${theme}']{${vars.join(';')}}</style>`;
}
const themeStyle = [themeStyleBlock('normal', settings.themeNormal), themeStyleBlock('reader', settings.themeReader)].join('');

// 字体按默认主题拆分：默认主题用到的家族阻塞加载（渲染必需）；
// 另一主题独有的家族异步预载（onload 转 stylesheet），切换主题时字体已就绪又不拖慢首屏
const GF = 'https://fonts.googleapis.com/css2';
const NOTO_MONO = 'family=Noto+Serif+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap';
const normalFonts = `${GF}?family=Playfair+Display:ital,wght@0,400..800;1,400..700&${NOTO_MONO}`;
const normalOnlyFonts = `${GF}?family=Lora:ital,wght@0,400..700;1,400..700&family=EB+Garamond:ital,wght@0,400..700;1,400..700&display=swap`;
const readerFonts = `${GF}?family=Lora:ital,wght@0,400..700;1,400..700&family=EB+Garamond:ital,wght@0,400..700;1,400..700&${NOTO_MONO}`;
const readerOnlyFonts = `${GF}?family=Playfair+Display:ital,wght@0,400..800;1,400..700&display=swap`;
const isReaderDefault = defaultTheme === 'reader';
const blockingFonts = isReaderDefault ? readerFonts : normalFonts;
const lazyFonts = isReaderDefault ? readerOnlyFonts : normalOnlyFonts;

// SEO：canonical / og / twitter 标签统一注入（相对 URL 解析为绝对，便于搜索引擎与社交分享抓取）
const ogTitle = title ? `${title} · ${siteName}` : siteName;
const baseUrl = settings.siteUrl || 'http://localhost';
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).href;
const pageImage = new URL(image || '/banner.png', baseUrl).href;
---
<!doctype html>
<html lang="zh-CN" data-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={pageImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <!-- 首帧前应用 localStorage 保存的主题，防止刷新时闪现默认（normal）主题 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mblog_theme');
          if (saved === 'normal' || saved === 'reader') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* localStorage 不可用时忽略 */
        }
        // 低端设备标记：首帧前设置，CSS 据此关闭 backdrop-filter 等高开销效果
        // （避免低端机先渲染重效再降级的闪烁）；桌面端不命中，全部炫酷效果保留
        try {
          var nav = navigator;
          var lowEnd = (nav.hardwareConcurrency || 4) < 4
            || (nav.deviceMemory || 4) < 4
            || matchMedia('(pointer: coarse)').matches;
          if (lowEnd) document.documentElement.setAttribute('data-lowend', 'true');
        } catch (e) {
          /* 能力检测失败时保守起见不动 */
        }
      })();
    </script>
    <!-- 字体：默认主题家族（Playfair/Noto Serif SC 思源宋体/Lora/EB Garamond + JetBrains Mono）按需加载 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={blockingFonts} rel="stylesheet" />
    <!-- 另一主题独有字体：异步预载（不阻塞首屏渲染），切换主题时已就绪 -->
    <link rel="preload" as="style" href={lazyFonts} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={lazyFonts} /></noscript>
    <!-- 后台主题配置：覆盖主题 CSS 变量 -->
    <Fragment set:html={themeStyle} />
    <!-- 页面级 SEO 补充（如首页 JSON-LD） -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主内容</a>
    <!-- 顶部阅读进度条（双主题通用） -->
    <div class="nav-progress" aria-hidden="true"></div>

    <!-- 顶栏导航：normal 主题使用（极简模式通过 CSS 隐藏，改用侧栏导航） -->
    <header class="site-header">
      <div class="inner">
        <PillNav client:load items={navItemsNormal} path={path} />
      </div>
    </header>

    <!-- 移动端导航：≤768px 显示（双主题通用），替代桌面导航；媒体条件水合，桌面端零 JS 开销 -->
    <MobileHeader client:media="(max-width: 768px)" normalItems={navItemsNormal} readerItems={navItemsReader} siteName={siteName} initialTheme={settings.theme} />

    {layout === 'article' ? (
      <!-- 文章页：窄列竖排品牌 + 右侧目录 -->
      <div class="page-layout article-layout">
        <aside class="sidebar sidebar-vertical">
          <a class="brand-block" href="/" aria-label="返回首页">
            <span class="brand-name-vertical">{siteName}</span>
          </a>
        </aside>
        <main class="site-main" id="main-content"><slot /></main>
        <slot name="toc" />
      </div>
    ) : (
      <div class="page-layout">
        <aside class="sidebar">
          <header class="brand-area">
            <a class="brand-banner" href="/" aria-label="首页"><img src="/banner.png" alt={siteName} /></a>
            {settings.siteDesc && <p class="bio">{settings.siteDesc}</p>}
          </header>
          <nav class="site-nav">
            <div class="site-nav-menu" data-menu-for="normal">
              {navItemsNormal.map((item) =>
                item.url.startsWith('http') ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.label}</a>
                ) : (
                  <a href={item.url} class={isActive(item.url) ? 'active' : ''} aria-current={isActive(item.url) ? 'page' : undefined}>{item.label}</a>
                ),
              )}
            </div>
            <div class="site-nav-menu" data-menu-for="reader">
              {navItemsReader.map((item) =>
                item.url.startsWith('http') ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.label}</a>
                ) : (
                  <a href={item.url} class={isActive(item.url) ? 'active' : ''} aria-current={isActive(item.url) ? 'page' : undefined}>{item.label}</a>
                ),
              )}
            </div>
          </nav>
          <footer class="sidebar-footer">
            <div class="social-row">
              {settings.githubUsername && (
                <a class="social-icon" href={`https://github.com/${settings.githubUsername}`} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.53-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
                </a>
              )}
              <a class="social-icon" href="/api/rss" aria-label="RSS 订阅">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44v3.06c7.05 0 12.5 5.45 12.5 12.5h3.06C19.56 10.84 13.16 4.44 4 4.44zM4 10.1v3.06c3.88 0 6.84 2.96 6.84 6.84h3.06c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
              </a>
              <ThemeToggle client:load variant="icon" />
            </div>
            <span class="sidebar-copyright">© {year} {siteName}</span>
          </footer>
        </aside>
        <main class="site-main" id="main-content"><slot /></main>
      </div>
    )}

    <footer class="site-footer">
      <span class="site-footer-text">© {year} {siteName}</span>
      <div class="tech-loop" aria-hidden="true">
        <div class="tech-loop__track">
          {[...TECH_LOGOS, ...TECH_LOGOS].map((t) => (
            <span class="tech-loop__item" title={t.name}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill={t.color} aria-hidden="true"><path d={t.path} /></svg>
            </span>
          ))}
        </div>
      </div>
      <span class="footer-right">Powered by MBLOG</span>
    </footer>
    <script>
      import '../scripts/lenis.ts';
      import '../scripts/reveal.ts';
    </script>
    <script is:inline>
      // 顶部阅读进度条
      (function () {
        var bar = document.querySelector('.nav-progress');
        if (!bar) return;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.width = (max > 0 ? Math.min(1, h.scrollTop / max) * 100 : 0) + '%';
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size);
    line-height: var(--line-height);
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--color-primary); }
  /* 主题切换过渡：淡出 → 切换 → 淡入 */
  body { transition: opacity 0.2s ease; }
  html.theme-switching body { opacity: 0; }
  /* 顶部阅读进度条 */
  .nav-progress {
    position: fixed; top: 0; left: 0; width: 0; height: 2px;
    background: var(--color-primary);
    z-index: 9998; pointer-events: none;
    transition: width 0.1s linear;
  }
  /* 移动端导航：桌面隐藏，≤768px 显示 */
  .mobile-header { display: none; }
  @media (max-width: 768px) {
    .mobile-header { display: block; }
  }
  /* 顶栏（normal 主题） */
  .site-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .nav { display: flex; gap: 16px; align-items: center; }
  .nav a { color: var(--color-text-muted); text-decoration: none; font-size: 14px; }
  .nav a:hover { color: var(--color-primary); }
  .site-main { min-width: 0; min-height: calc(100vh - 120px); }
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 20px;
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
    font-size: 14px;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  /* markdown 正文基础 */
  .markdown-body { line-height: var(--line-height); word-break: break-word; }
  .markdown-body h1, .markdown-body h2, .markdown-body h3 { margin: 1.4em 0 0.6em; line-height: 1.4; }
  .markdown-body p { margin: 0.8em 0; }
  .markdown-body code { background: var(--color-code-bg); border-radius: 4px; padding: 2px 5px; font-family: var(--font-mono); font-size: 0.9em; }
  .markdown-body pre { background: var(--color-code-bg); padding: 16px; border-radius: var(--radius); overflow-x: auto; }
  .markdown-body pre code { background: transparent; padding: 0; }
  .markdown-body img { max-width: 100%; border-radius: var(--radius); }
  .markdown-body audio { max-width: 100%; margin: 0.8em 0; }
  .markdown-body blockquote { margin: 0.8em 0; padding-left: 14px; border-left: 3px solid var(--color-border); color: var(--color-text-muted); }
  .markdown-body table { border-collapse: collapse; margin: 0.8em 0; width: 100%; }
  .markdown-body th, .markdown-body td { border: 1px solid var(--color-border); padding: 8px 12px; }
  /* 文章列表卡片（normal 主题） */
  .post-list { display: flex; flex-direction: column; gap: 16px; }
  .post-card { padding: var(--card-padding); }
  .post-card .post-title { margin: 0 0 8px; font-size: 20px; }
  .post-card .post-title a { color: var(--color-text); text-decoration: none; }
  .post-card .post-title a:hover { color: var(--color-primary); }
  .post-card .post-summary { color: var(--color-text-muted); margin: 0 0 12px; font-size: 14px; line-height: 1.6; }
  .post-meta { display: flex; gap: 16px; flex-wrap: wrap; color: var(--color-text-muted); font-size: 13px; align-items: center; }
  .post-empty { text-align: center; color: var(--color-text-muted); padding: 48px 0; }
  /* 键盘焦点可见（双主题通用，跟随 --color-primary） */
  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* 跳到主内容：平时离屏，Tab 聚焦时现身（键盘可达性） */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 9999;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: 8px 16px;
    border-radius: 0 0 8px 8px;
    text-decoration: none;
    font-size: 14px;
  }
  .skip-link:focus {
    left: 0;
  }
  /* 双主题导航：仅显示当前主题对应的菜单（侧栏） */
  .site-nav [data-menu-for] {
    display: none;
  }
  html[data-theme='normal'] .site-nav [data-menu-for='normal'],
  html[data-theme='reader'] .site-nav [data-menu-for='reader'] {
    display: flex;
    flex-direction: column;
  }
</style>
