---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCategories, type Category } from '../../lib/api';

const categories = await getCategories().catch(() => [] as Category[]);

// 分类图标（features-01-luma 左上角 icon 结构；项目内联 SVG，stroke 风格跟随 currentColor）
const CAT_ICONS: Record<string, string> = {
  code: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  terminal: 'M4 17l6-6-6-6M12 19h8',
  book: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
  camera: 'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
  music: 'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  palette: 'M12 22a10 10 0 1 1 10-10c0 1.5-1 2.5-2.5 2.5H17a2 2 0 0 0-1.5 3.3c.6.7.5 1.7-.5 1.7h-1A5 5 0 0 1 9 14a5 5 0 0 1 5-5c1.7 0 3 1.3 3 3',
  rocket: 'M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2 0-2.8-.8-.7-2.2-.7-3 .8zM12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.7 7.2-4 10.4a22 22 0 0 1-3.9 2zM9 12H4s.5-3.5 2-5c1.5-1.6 5-2 5-2M12 15v5s3.5-.5 5-2c1.5-1.6 2-5 2-5',
  heart: 'M19 14c1.5-1.5 3-3.3 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3.4 1-4.5 2.5C10.9 4 9.3 3 7.5 3A5.5 5.5 0 0 0 2 8.5c0 2.2 1.5 4 3 5.5l7 7z',
  gamepad: 'M6 12h4M8 10v4M15 13h.01M18 11h.01M17.3 5H6.7a5 5 0 0 0-4.9 6l1.6 6a3 3 0 0 0 2.9 2.3h1.7a3 3 0 0 0 2.6-1.4l1.1-1.7a2 2 0 0 1 3.4 0l1.1 1.7a3 3 0 0 0 2.6 1.4h1.7a3 3 0 0 0 2.9-2.3l1.6-6a5 5 0 0 0-4.9-6z',
  globe: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z',
  layers: 'M12 2l10 6-10 6L2 8zM2 12l10 6 10-6M2 16l10 6 10-6',
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
};

// 按分类名关键词映射图标（无命中回退 9 宫格）
function catIcon(name: string): string {
  const kw: [RegExp, string][] = [
    [/前端|html|css|javascript|js|react|vue|web|小程序/i, 'code'],
    [/后端|server|node|api|数据库|运维|docker|golang|python/i, 'terminal'],
    [/随笔|日记|生活|杂谈|日常|感悟/i, 'book'],
    [/摄影|图片|相册|照片/i, 'camera'],
    [/影音|音乐|电影|douban|观影/i, 'music'],
    [/设计|ui|视觉|艺术/i, 'palette'],
    [/ai|人工智能|机器|大模型/i, 'rocket'],
    [/游戏|game/i, 'gamepad'],
    [/收藏|好物|书单|阅读|读书/i, 'heart'],
    [/旅行|游记|出游/i, 'globe'],
  ];
  for (const [re, key] of kw) if (re.test(name)) return CAT_ICONS[key];
  return CAT_ICONS.grid;
}
const iconPath = (name: string) => catIcon(name);
const total = categories.reduce((n, c) => n + c.postCount, 0);
// 特色图相对路径 → 公共绝对 URL（生产走 nginx 同域 /uploads 反代保持相对，本地直跑设 PUBLIC_API_BASE）
const PUBLIC_API_BASE = process.env.PUBLIC_API_BASE ?? '';
const absUrl = (u: string) => (u.startsWith('/') && PUBLIC_API_BASE ? `${PUBLIC_API_BASE}${u}` : u);
---
<BaseLayout title="分类" description="按分类浏览全部文章。">
  <PageHeader title="分类" subtitle="按分类浏览全部文章" count={`共 ${categories.length} 个分类 · ${total} 篇`} class="category-page">
    {categories.length > 0 ? (
      <div class="cat-luma-wrap">
        {/* Luma 风格透视网格背景（暗色版：低透明度白线 + 渐隐） */}
        <div class="cat-grid-bg" aria-hidden="true" />
        <div class="cat-luma">
          {categories.map((c, i) => (
            <a class="cat-card" href={`/category/${c.slug}`} data-reveal style={`--reveal-delay: ${(i % 8) * 50}ms`}>
              {/* Luma 原版 hover 背景图：特色图浮现 + 暗色遮罩（无特色图时回退琥珀光晕） */}
              {c.cover && (
                <span class="cat-bg" aria-hidden="true">
                  <img src={absUrl(c.cover)} alt="" loading="lazy" />
                </span>
              )}
              <span class="cat-glow" aria-hidden="true" />
              <span class="cat-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPath(c.name)} /></svg>
              </span>
              <span class="cat-card-foot">
                <span class="cat-card-name">{c.name}</span>
                <span class="cat-card-count">{c.postCount} 篇</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    ) : (
      <p class="post-empty">暂无分类</p>
    )}
  </PageHeader>
</BaseLayout>
