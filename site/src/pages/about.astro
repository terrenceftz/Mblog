---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPublicSettings, getStats } from '../lib/api';

const settings = Astro.locals.settings ?? (await getPublicSettings());
const siteName = settings.author || settings.siteName || '我的博客';
const avatarUrl = settings.avatar || '/avatar.jpg';
const themeNormal = settings.themeNormal ?? {};
const introText = themeNormal.intro || '一个喜欢折腾代码和生活的博主';
const stats = await getStats().catch(() => ({ postTotal: 0, commentTotal: 0, totalViews: 0, friendLinkCount: 0 }));
const year = new Date().getFullYear();
// eonova 名片式：关于内容按空行分段，每段一个名片块（段首 emoji 作为区块标签）
const aboutBlocks = (settings.aboutContent || '')
  .split(/\n\s*\n/)
  .map((s) => s.trim())
  .filter(Boolean);
---
<BaseLayout title="关于" description="关于这个博客与博主。">
  <PageHeader title="关于" subtitle="关于这个博客与博主。" class="about-page">
    <div class="about-card">
      <img class="about-avatar" src={avatarUrl} alt={siteName} data-reveal />
      <p class="about-kicker" data-reveal style="--reveal-delay: 60ms">HELLO, I AM</p>
      <h2 class="about-name" data-reveal style="--reveal-delay: 120ms">{siteName}</h2>
      <p class="about-intro" data-reveal style="--reveal-delay: 180ms">{introText}</p>
      {settings.siteDesc && <p class="about-desc" data-reveal style="--reveal-delay: 220ms">{settings.siteDesc}</p>}

      {aboutBlocks.length > 0 && (
        <div class="about-blocks">
          {aboutBlocks.map((block, bi) => {
            const chars = [...block];
            const first = chars[0];
            // 段首 emoji 检测：命中则作为名片块标签放大显示
            const hasEmoji = /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE0F}\u{2190}-\u{21FF}\u{2B00}-\u{2BFF}\u{2700}-\u{27BF}]/u.test(first || '');
            const text = hasEmoji ? block.slice(chars[0].length).trim() : block;
            return (
              <div class="about-block" data-reveal style={`--reveal-delay: ${260 + bi * 60}ms`}>
                {hasEmoji && <span class="about-block-emoji" aria-hidden="true">{first}</span>}
                <p class="about-block-text">{text}</p>
              </div>
            );
          })}
        </div>
      )}

      <div class="about-stats" data-reveal style="--reveal-delay: 120ms">
        <div class="about-stat"><span>{stats.postTotal}</span><em>文章</em></div>
        <div class="about-stat"><span>{stats.commentTotal}</span><em>评论</em></div>
        <div class="about-stat"><span>{stats.totalViews}</span><em>浏览</em></div>
        <div class="about-stat"><span>{stats.friendLinkCount}</span><em>友链</em></div>
      </div>

      <div class="about-links" data-reveal style="--reveal-delay: 180ms">
        {settings.githubUsername && (
          <a href={`https://github.com/${settings.githubUsername}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        )}
        {settings.doubanUid && (
          <a href={`https://www.douban.com/people/${settings.doubanUid}/`} target="_blank" rel="noopener noreferrer">豆瓣 ↗</a>
        )}
        <a href="/api/rss" target="_blank" rel="noopener noreferrer">RSS ↗</a>
      </div>

      <p class="about-copyright" data-reveal style="--reveal-delay: 240ms">© {year} {siteName} · Powered by MBLOG</p>
    </div>
  </PageHeader>
</BaseLayout>
