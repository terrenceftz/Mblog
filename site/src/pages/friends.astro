---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FriendLinkSection from '../components/FriendLinkSection.vue';
import { getFriendLinks, getPublicSettings, type FriendLink } from '../lib/api';

const links = await getFriendLinks().catch(() => []);
// 本站信息卡数据（与首页 hero 同一回退链）；头像转绝对 URL 供他人复制
const settings = Astro.locals.settings ?? (await getPublicSettings());
const siteName = settings.author || settings.siteName || '我的博客';
const themeNormal = settings.themeNormal ?? {};
const avatarRaw = settings.avatar || themeNormal.avatar || '/avatar.jpg';
const siteUrl = (settings.siteUrl || '').replace(/\/$/, '');
const avatarUrl = /^https?:\/\//.test(avatarRaw) ? avatarRaw : `${siteUrl}${avatarRaw}`;
---
<BaseLayout title="友情链接" description="交换链接，一起写作。">
  <PageHeader title="友情链接" subtitle="交换链接，一起写作。" count={`共 ${links.length} 个站点`} class="friends-page">
    {links.length > 0 ? (
      <div class="link-grid">
        {links.map((l: FriendLink) => (
            <a class="link-card" href={l.url} target="_blank" rel="noopener noreferrer">
              {l.avatar ? (
                <img class="link-avatar-img" src={l.avatar} alt={l.name} loading="lazy" />
              ) : (
                <div class="link-avatar">{l.name.slice(0, 1)}</div>
              )}
            <div>
              <div class="link-name">{l.name}</div>
              {l.description && <div class="link-desc">{l.description}</div>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="link-empty">暂无友链</p>
    )}
    <FriendLinkSection
      client:visible
      siteName={siteName}
      siteDesc={settings.siteDesc ?? ''}
      siteUrl={siteUrl}
      avatarUrl={avatarUrl}
      enabled={settings.friendLinkEnabled !== false}
    />
  </PageHeader>
</BaseLayout>

<style is:global>
  .link-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px;
    max-width: var(--max-width); margin: 0 auto;
  }
  .link-card {
    display: flex; gap: 12px; align-items: center; padding: 14px;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius); box-shadow: var(--shadow); text-decoration: none; color: var(--color-text);
  }
  .link-avatar {
    width: 40px; height: 40px; border-radius: 50%; background: var(--color-primary);
    color: var(--color-primary-contrast); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;
  }
  .link-avatar-img {
    width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
  }
  .link-name { font-weight: 600; }
  .link-desc { color: var(--color-text-muted); font-size: 13px; margin-top: 2px; }
  .link-empty { color: var(--color-text-muted); padding: 24px 0; text-align: center; }
</style>
