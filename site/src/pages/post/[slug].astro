---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentSection from '../../components/CommentSection.vue';
import { getPost, type PostDetail } from '../../lib/api';
import { withTocIds } from '../../lib/toc';

const { slug } = Astro.params;
let post: PostDetail;
try {
  post = await getPost(slug!);
} catch {
  return Astro.redirect('/404');
}
// 提取 h2/h3 生成目录锚点；返回带 id 的正文 HTML 与目录项
const { html: contentHtml, toc } = withTocIds(post.contentHtml);
---
<BaseLayout title={post.title} description={post.summary} layout="article">
  <article class="article-wrapper">
    <header class="article-header">
      <h1 class="article-title">{post.title}</h1>
      <div class="article-meta">
        {post.category && <a href={`/category/${post.category.slug}`}>{post.category.name}</a>}
        <time datetime={new Date(post.createdAt).toISOString()}>{new Date(post.createdAt).toLocaleDateString('zh-CN')}</time>
        <span>{post.viewCount} 次阅读</span>
      </div>
    </header>
    {/* 后端已渲染并防 XSS 的 HTML（前端注入标题锚点 id） */}
    <div class="article-content markdown-body" set:html={contentHtml} />
    {post.tags.length > 0 && (
      <footer class="article-footer">
        <ul class="tags">
          {post.tags.map((t) => (
            <li><a class="tag" href={`/tag/${t.slug}`}>{t.name}</a></li>
          ))}
        </ul>
      </footer>
    )}
    <CommentSection client:load postId={post.id} />
  </article>
  {toc.length > 0 && (
    <Fragment slot="toc">
      <nav class="article-toc" aria-label="文章目录">
        <p class="article-toc-title">目录</p>
        <ul>
          {toc.map((t) => (
            <li><a class={t.level === 3 ? 'toc-h3' : undefined} href={`#${t.id}`}>{t.text}</a></li>
          ))}
        </ul>
      </nav>
    </Fragment>
  )}
</BaseLayout>

<script>
  // 文章目录滚动高亮当前章节
  const tocLinks = [...document.querySelectorAll('.article-toc a')]
    .map((a) => ({ a, id: a.getAttribute('href')?.slice(1) }))
    .filter((x) => x.id);
  if (tocLinks.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            for (const { a, id } of tocLinks) a.classList.toggle('toc-active', id === entry.target.id);
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );
    for (const { id } of tocLinks) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }
</script>
