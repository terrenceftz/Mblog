---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentSection from '../../components/CommentSection.vue';
import LikeButton from '../../components/LikeButton.vue';
import MobileToc from '../../components/MobileToc.vue';
import GradientBlob from '../../components/GradientBlob.vue';
import { getPost, getPublicSettings, type PostDetail } from '../../lib/api';
import { withTocIds } from '../../lib/toc';

const { slug } = Astro.params;
let post: PostDetail;
try {
  post = await getPost(slug!);
} catch {
  return Astro.redirect('/404');
}
// 提取 h2/h3 生成目录锚点；返回带 id 的正文 HTML 与目录项
const { html: contentHtml, toc } = withTocIds(post.contentHtml);
// 评论云验证（Turnstile）site key：中间件已共享设置，未命中时兜底直取
const settings = Astro.locals.settings ?? (await getPublicSettings());
---
<BaseLayout title={post.title} description={post.summary} layout="article">
  {/* JSON-LD 结构化数据（SEO：BlogPosting schema） */}
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.summary,
      image: post.cover ? `${settings.siteUrl}${post.cover}` : undefined,
      datePublished: new Date(post.createdAt).toISOString(),
      dateModified: new Date(post.updatedAt).toISOString(),
      author: { '@type': 'Person', name: settings.siteName },
      publisher: { '@type': 'Person', name: settings.siteName },
      mainEntityOfPage: `${settings.siteUrl}/post/${post.slug}`,
      wordCount: post.contentHtml.replace(/<[^>]+>/g, '').length,
    })}
  />
  {/* 文章头部：有封面时标题压在 banner 图内居中；无封面时居中标题 + 渐变光装饰 */}
  <div class={`article-head ${post.cover ? 'has-cover' : ''}`}>
    <GradientBlob />
    {post.cover ? (
      <div class="article-hero">
        <img src={post.cover} alt={post.title} />
        <header class="article-header">
          <h1 class="article-title">{post.title}</h1>
          <div class="article-meta">
            {post.category && <a href={`/category/${post.category.slug}`}>{post.category.name}</a>}
            <time datetime={new Date(post.createdAt).toISOString()}>{new Date(post.createdAt).toLocaleDateString('zh-CN')}</time>
            <span>{post.viewCount} 次阅读</span>
            <LikeButton client:load slug={post.slug} initialCount={post.likeCount} />
          </div>
        </header>
      </div>
    ) : (
      <header class="article-header">
        <h1 class="article-title">{post.title}</h1>
        <div class="article-meta">
          {post.category && <a href={`/category/${post.category.slug}`}>{post.category.name}</a>}
          <time datetime={new Date(post.createdAt).toISOString()}>{new Date(post.createdAt).toLocaleDateString('zh-CN')}</time>
          <span>{post.viewCount} 次阅读</span>
          <LikeButton client:load slug={post.slug} initialCount={post.likeCount} />
        </div>
      </header>
    )}
  </div>
  <article class="article-wrapper">
    {/* 后端已渲染并防 XSS 的 HTML（前端注入标题锚点 id） */}
    <div class="article-content markdown-body" set:html={contentHtml} />
    {post.tags.length > 0 && (
      <footer class="article-footer">
        <ul class="tags">
          {post.tags.map((t) => (
            <li><a class="tag" href={`/tag/${t.slug}`}>{t.name}</a></li>
          ))}
        </ul>
      </footer>
    )}
    {/* 上一篇 / 下一篇 */}
    {(post.prev || post.next) && (
      <nav class="post-nav" aria-label="前后文章">
        {post.prev ? (
          <a class="post-nav-item prev" href={`/post/${post.prev.slug}`}>
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title">{post.prev.title}</span>
          </a>
        ) : (
          <span class="post-nav-item empty" aria-hidden="true" />
        )}
        {post.next ? (
          <a class="post-nav-item next" href={`/post/${post.next.slug}`}>
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title">{post.next.title}</span>
          </a>
        ) : (
          <span class="post-nav-item empty" aria-hidden="true" />
        )}
      </nav>
    )}
    <CommentSection client:load postId={post.id} turnstileSiteKey={settings.turnstileSiteKey ?? ''} />
  </article>
  {toc.length > 0 && (
    <Fragment slot="toc">
      <nav class="article-toc line-sidebar" aria-label="文章目录">
        <p class="article-toc-title">目录</p>
        <ul class="line-sidebar__list">
          {toc.map((t, i) => (
            <li class="line-sidebar__item">
              <span class="line-sidebar__marker" aria-hidden="true" />
              <a class={`line-sidebar__label ${t.level === 3 ? 'toc-h3' : ''}`.trim()} href={`#${t.id}`}>
                <span class="line-sidebar__index">{String(i + 1).padStart(2, '0')}</span>
                <span class="line-sidebar__text">{t.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </Fragment>
  )}
  {/* 移动端目录抽屉（窄屏显示） */}
  {toc.length > 0 && <MobileToc client:load items={toc} />}
</BaseLayout>

<script>
  // 文章目录：滚动高亮 + LineSidebar 线标动效（reactbits 移植）
  const sidebarList = document.querySelector('.article-toc .line-sidebar__list');
  const sidebarItems = sidebarList ? [...sidebarList.querySelectorAll('.line-sidebar__item')] : [];
  const links = sidebarItems.map((li) => li.querySelector('.line-sidebar__label'));

  // 滚动高亮：IntersectionObserver 驱动 activeIndex
  const activeIndex = { v: -1 };
  let startLoop = () => {};
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const idx = links.findIndex((a) => a && a.getAttribute('href') === `#${entry.target.id}`);
          if (idx >= 0) {
            activeIndex.v = idx;
            startLoop(); // 激活项变化 → 重启缓动循环
          }
        }
      }
    },
    { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
  );
  for (const a of links) {
    const el = a && document.getElementById(a.getAttribute('href')?.slice(1));
    if (el) observer.observe(el);
  }

  // LineSidebar：指针接近度 + 激活项 → rAF 缓动每个条目的 --effect（0..1）
  if (sidebarItems.length) {
    const smooth = (p) => p * p * (3 - 2 * p);
    const PROXIMITY = 100;
    const cur = sidebarItems.map(() => 0);
    const tgt = sidebarItems.map(() => 0);
    let raf = null;
    let last = 0;

    const frame = (now) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      const k = 1 - Math.exp(-dt / 0.1); // 指数缓动，smoothing ≈ 100ms
      let moving = false;
      sidebarItems.forEach((li, i) => {
        const target = Math.max(tgt[i] || 0, activeIndex.v === i ? 1 : 0);
        const next = cur[i] + (target - cur[i]) * k;
        cur[i] = Math.abs(target - next) < 0.0015 ? target : next;
        li.style.setProperty('--effect', cur[i].toFixed(4));
        if (cur[i] !== target) moving = true;
      });
      raf = moving ? requestAnimationFrame(frame) : null;
    };
    const start = () => {
      if (raf != null) cancelAnimationFrame(raf);
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    startLoop = start;

    sidebarList.addEventListener('pointermove', (e) => {
      const rect = sidebarList.getBoundingClientRect();
      const pointerY = e.clientY - rect.top;
      sidebarItems.forEach((li, i) => {
        const center = li.offsetTop + li.offsetHeight / 2;
        const d = Math.abs(pointerY - center);
        tgt[i] = smooth(Math.max(0, 1 - d / PROXIMITY));
      });
      start();
    });
    sidebarList.addEventListener('pointerleave', () => {
      tgt.fill(0);
      start();
    });
    start();
  }

  // 目录过长：内容超出可视区时给底部加渐隐提示（has-more）
  const tocEl = document.querySelector('.article-toc');
  const updateTocFade = () => {
    if (!tocEl) return;
    tocEl.classList.toggle('has-more', tocEl.scrollHeight > tocEl.clientHeight + 4);
  };
  updateTocFade();
  window.addEventListener('resize', updateTocFade);
</script>
