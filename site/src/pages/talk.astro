---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getTalks, type Talk } from '../lib/api';
import { fmtDateTime } from '../lib/date';

const talks: Talk[] = await getTalks().catch(() => []);
---
<BaseLayout title="说说" description="短动态与碎碎念。">
  <PageHeader title="说说" subtitle="短动态与碎碎念。" count={`共 ${talks.length} 条`} class="talk-page">
    {talks.length > 0 ? (
      <ul class="posts-list talk-list">
        {talks.map((t) => (
          <li class="posts-item talk-item">
            <p class="talk-content">{t.content}</p>
            <div class="posts-meta">
              <time class="posts-date">{fmtDateTime(t.createdAt)}</time>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="posts-more-done" style="text-align:center">还没有说说~</p>
    )}
  </PageHeader>
</BaseLayout>
