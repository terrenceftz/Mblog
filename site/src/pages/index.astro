---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackground from '../components/HeroBackground.vue';
import BlurText from '../components/BlurText.vue';
import BorderGlow from '../components/BorderGlow.vue';
import StatBubbles from '../components/StatBubbles.vue';
import EyeIcon from '../components/EyeIcon.astro';
import {
  getPosts, getPublicSettings, getCategories, getTags, getStats, getDouban, getProjects,
  type PostListItem, type Category, type Tag, type DoubanMovie,
} from '../lib/api';
import { optimizeImage, type OptimizedImage } from '../lib/img';

const settings = Astro.locals.settings ?? (await getPublicSettings());
// 博主名称/头像：优先后台「站点设置→站点基础信息」的博主名称/头像，回退站点名与主题配置
const siteName = settings.author || settings.siteName || '我的博客';
// 首页文章数：默认主题配置决定（双主题架构下 SSR 以默认主题为准）
const defaultTheme = settings.theme === 'reader' ? settings.themeReader : settings.themeNormal;
// normal 首屏为「1 特写 + 4 常规」共 5 篇，按需取数；reader 时间线用主题配置的文章数
const pageSize = settings.theme === 'reader' ? (defaultTheme.homePageSize ?? 10) : 5;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1));
const data = await getPosts({ page, pageSize }).catch(() => ({ list: [] as PostListItem[], total: 0 }));
const total = data.total;
const totalPages = Math.max(1, Math.ceil(total / pageSize));

// 干支纪年：2026 -> 丙午
const GAN = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
const ZHI = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
function yearGanzhi(year: number): string {
  return GAN[(year - 4) % 10] + ZHI[(year - 4) % 12];
}
function fmtMonthDay(ts: number): string {
  const d = new Date(ts);
  return `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
const yearGroups: { year: number; ganzhi: string; items: PostListItem[] }[] = [];
for (const post of data.list) {
  const y = new Date(post.createdAt).getFullYear();
  const last = yearGroups[yearGroups.length - 1];
  if (last && last.year === y) last.items.push(post);
  else yearGroups.push({ year: y, ganzhi: yearGanzhi(y), items: [post] });
}

// 正常主题首页数据（各模块；失败时优雅降级为空）
const [categories, tags, stats, doubanData, projectsData] = await Promise.all([
  getCategories().catch(() => []),
  getTags().catch(() => []),
  getStats().catch(() => ({ postTotal: 0, commentTotal: 0, totalViews: 0, friendLinkCount: 0 })),
  getDouban().catch(() => ({ enabled: false, movies: [] })),
  getProjects().catch(() => ({ enabled: false, projects: [] })),
]);
const catName = (id: number | null) => categories.find((c) => c.id === id)?.name ?? '';

// 首屏头像与自我介绍（后台「正常模式主题设置」可配，缺省回退默认）
const themeNormal = settings.themeNormal ?? {};
const avatarUrl = settings.avatar || themeNormal.avatar || '/avatar.jpg';
const introText = themeNormal.intro || '一个喜欢折腾代码和生活的博主';

// 封面/头像等媒体相对路径 → 公共绝对 URL。PUBLIC_API_BASE 是浏览器可访问的 API 根：
// 生产靠 nginx 同域 /api、/uploads 反代（不设即保持相对路径）；本地直跑无反代时
// 设 PUBLIC_API_BASE=http://localhost:3000 让图片直连后端。注意 API_BASE 是服务器内网地址
// （如 localhost:3003），绝不能直接拼进 HTML 给浏览器。
const PUBLIC_API_BASE = process.env.PUBLIC_API_BASE ?? '';
const absUrl = (u: string) => (u.startsWith('/') && PUBLIC_API_BASE ? `${PUBLIC_API_BASE}${u}` : u);

// 响应式封面（多尺寸 webp srcset）：首页索引封面（小卡 190px）与豆瓣条海报（细带 ~220px）
const previewItems: { p: PostListItem; cover: OptimizedImage | null }[] = await Promise.all(
  data.list.slice(0, 5).map(async (p) => ({
    p,
    cover: p.cover ? await optimizeImage(p.cover, { base: Astro.request.url, widths: [400, 800], sizes: '280px' }) : null,
  })),
);
const doubanItems: { m: DoubanMovie; cover: OptimizedImage | null }[] = await Promise.all(
  doubanData.movies.slice(0, 8).map(async (m) => ({
    m,
    cover: m.cover ? await optimizeImage(m.cover, { base: Astro.request.url, widths: [300, 600], sizes: '220px' }) : null,
  })),
);

// 首页结构化数据：WebSite（含站内搜索）+ Person（博主档案），文章页另有 BlogPosting
const baseUrl = (settings.siteUrl || 'http://localhost').replace(/\/$/, '');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: settings.siteName || '我的博客',
      description: settings.siteDesc,
      url: `${baseUrl}/`,
      inLanguage: 'zh-CN',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${baseUrl}/search?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Person',
      name: siteName,
      url: `${baseUrl}/about`,
      description: introText,
      image: new URL(avatarUrl, baseUrl).href,
      ...(settings.githubUsername ? { sameAs: [`https://github.com/${settings.githubUsername}`] } : {}),
    },
  ],
});
---
<BaseLayout description={settings.siteDesc}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} is:inline />

  <!-- ======== 极简主题首页：干支时间线（normal 主题隐藏） ======== -->
  <div class="reader-home">
    <div class="content-stream">
      {yearGroups.map((g) => (
        <section class="year-group">
          <h2 class="year-label" id={`year-${g.year}`} title={String(g.year)}>{g.ganzhi}</h2>
          <ul class="year-list">
            {g.items.map((post) => (
              <li class="year-item">
                <div class="item-main">
                  <span class="item-date">{fmtMonthDay(post.createdAt)}</span>
                  <a class="item-title" href={`/post/${post.slug}`}>{post.title}</a>
                </div>
                {post.summary && <p class="item-summary">{post.summary}</p>}
                <span class="item-views"><EyeIcon count={post.viewCount} /></span>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {data.list.length === 0 && <p class="post-empty">暂无文章</p>}
    </div>
    {totalPages > 1 && (
      <nav class="pagination">
        {page > 1 && <a href={`/?page=${page - 1}`}>← 前页</a>}
        <span class="page-info">{page} / {totalPages}</span>
        {page < totalPages && <a href={`/?page=${page + 1}`}>后页 →</a>}
      </nav>
    )}
  </div>

  <!-- ======== 正常主题首页：内容丰富模块（极简主题隐藏） ======== -->
  <div class="normal-home">
    <!-- 首屏（Liquid Ether 流体背景；左侧文字 + 右侧头像，统计气泡弹出于头像右侧） -->
    <section class="nh-hero">
      <HeroBackground client:visible />
      <div class="nh-hero-content nh-hero-split">
        <div class="nh-intro">
          <p class="nh-eyebrow"><BlurText client:load text="NOVA EON · BLOG" start-delay={0} delay={60} /></p>
          <h1 class="nh-title">
            <span class="nh-title-lead">你好，我是</span><BlurText
              client:load
              class="nh-title-name"
              text={siteName}
              start-delay={380}
              delay={70}
              stepDuration={0.3}
            />
          </h1>
          <BlurText client:load class="nh-witty" text={introText} start-delay={1000} delay={110} />
        </div>
        <div class="nh-avatar-wrap">
          <div class="nh-avatar"><img src={avatarUrl} alt={siteName} /></div>
          <StatBubbles
            client:visible
            postTotal={stats.postTotal}
            commentTotal={stats.commentTotal}
            totalViews={stats.totalViews}
            friendLinkCount={stats.friendLinkCount}
          />
        </div>
      </div>
    </section>

    <div class="nh-container">
    {/* 卡片辉光控制器：事件委托跟踪所有 border-glow-card 的光标位置 */}
    <BorderGlow client:load />
    <!-- 最新文章（编辑式索引列表：序号 + 日期 + 大标题；hover 封面浮动浮现） -->
    <section class="nh-section">
      <div class="nh-section-head" data-reveal>
        <h2>最新文章<span class="nh-head-en">Writing</span></h2>
        <span class="nh-head-rule" aria-hidden="true" />
        <a class="nh-more" href="/posts">全部文章 →</a>
      </div>
      {data.list.length > 0 ? (
        <ol class="nh-post-index">
          {previewItems.map(({ p, cover }, i) => (
            <li class="nh-index-row" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <a class="nh-index-link" href={`/post/${p.slug}`}>
                <span class="nh-index-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="nh-index-date">{fmtMonthDay(p.createdAt)}</span>
                <span class="nh-index-main">
                  <span class="nh-index-title">{p.title}</span>
                  {p.summary && <span class="nh-index-summary">{p.summary}</span>}
                </span>
                {catName(p.categoryId) && <span class="nh-index-cat">{catName(p.categoryId)}</span>}
                <span class="nh-index-arrow" aria-hidden="true">→</span>
                {p.cover && (
                  <span class="nh-index-preview" aria-hidden="true">
                    <img src={cover ? cover.src : absUrl(p.cover)} srcset={cover?.srcset} sizes={cover?.sizes} alt="" loading="lazy" decoding="async" />
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="post-empty">暂无文章</p>
      )}
    </section>

    <!-- 分类与标签（目录式引导行 + mono 标签流） -->
    {(categories.length > 0 || tags.length > 0) && (
      <section class="nh-section">
        <div class="nh-section-head" data-reveal>
          <h2>分类与标签<span class="nh-head-en">Index</span></h2>
          <span class="nh-head-rule" aria-hidden="true" />
        </div>
        {categories.length > 0 && (
          <div class="nh-cats" data-reveal>
            {categories.map((c: Category) => (
              <a class="nh-cat" href={`/category/${c.slug}`}>
                <span class="nh-cat-name">{c.name}</span>
                <span class="nh-cat-leader" aria-hidden="true" />
                <span class="nh-cat-count">{c.postCount}</span>
              </a>
            ))}
          </div>
        )}
        {tags.length > 0 && (
          <div class="nh-tags" data-reveal style="--reveal-delay: 80ms">
            {tags.map((t: Tag) => (
              <a class="nh-tag" href={`/tag/${t.slug}`}>#{t.name}</a>
            ))}
          </div>
        )}
      </section>
    )}

    <!-- 影音与项目 -->
    <section class="nh-section">
      <div class="nh-sub" data-reveal>
        <div class="nh-section-head">
          <h2>最近观影<span class="nh-head-en">Screening</span></h2>
          <span class="nh-head-rule" aria-hidden="true" />
          <a class="nh-more" href="/douban">全部影音 →</a>
        </div>
        {doubanItems.length > 0 && (
          <div class="nh-douban">
            {doubanItems.map(({ m, cover }) => (
              <a class="nh-douban-item" href={m.url} target="_blank" rel="noopener noreferrer" title={m.title}>
                {m.cover ? <img src={cover ? cover.src : absUrl(m.cover)} srcset={cover?.srcset} sizes={cover?.sizes} alt={m.title} loading="lazy" decoding="async" /> : <span class="nh-douban-fallback">{m.title.slice(0, 1)}</span>}
                <span class="nh-douban-info">
                  <span class="nh-douban-title">{m.title}</span>
                  {m.rating > 0 && <span class="nh-douban-rating">★ {m.rating.toFixed(1)}</span>}
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
      <div class="nh-sub" data-reveal>
        <div class="nh-section-head">
          <h2>精选项目<span class="nh-head-en">Work</span></h2>
          <span class="nh-head-rule" aria-hidden="true" />
          <a class="nh-more" href="/projects">全部项目 →</a>
        </div>
        {projectsData.projects.length > 0 && (
          <div class="nh-projects">
            {projectsData.projects.slice(0, 6).map((p) => (
              <a class="nh-project border-glow-card" href={p.url} target="_blank" rel="noopener noreferrer">
                <span class="edge-light" aria-hidden="true" />
                <div class="border-glow-inner">
                  <span class="nh-project-name">{p.name}</span>
                  {p.description && <span class="nh-project-desc">{p.description}</span>}
                  {p.language && <span class="nh-project-lang">{p.language}</span>}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 分页默认样式（极简模式由 reader.css 覆盖） */
  .pagination {
    display: flex; gap: 16px; align-items: center; justify-content: center;
    padding: 24px 0; max-width: var(--max-width); margin: 0 auto;
  }
  .pagination a { color: var(--color-text); text-decoration: none; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 6px 14px; background: var(--color-surface); }
  .pagination a:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .page-info { color: var(--color-text-muted); font-size: 14px; }
</style>
