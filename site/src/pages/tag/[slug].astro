---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts, getTags } from '../../lib/api';

const { slug } = Astro.params;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1));
const pageSize = 10;
// 名称查询单独降级，避免拖垮整页；核心列表也兜底，失败时显示空
const [data, tags] = await Promise.all([
  getPosts({ tag: slug, page, pageSize }).catch(() => ({ list: [], total: 0 })),
  getTags().catch(() => []),
]);
const name = tags.find((t) => t.slug === slug)?.name ?? String(slug);
const totalPages = Math.max(1, Math.ceil(data.total / pageSize));
---
<BaseLayout title={`标签：${name}`} description={`带「#${name}」标签的全部文章。`}>
  <PageHeader title={`标签：# ${name}`} subtitle="标签下的全部文章" count={`共 ${data.total} 篇`}>
    <PostList posts={data.list} />
    <Pagination page={page} totalPages={totalPages} href={(n) => `/tag/${slug}?page=${n}`} />
  </PageHeader>
</BaseLayout>
