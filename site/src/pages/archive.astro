---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getArchive } from '../lib/api';
import { fmtMonthDay } from '../lib/date';

const groups = await getArchive();
const totalPosts = groups.reduce((n, g) => n + g.items.length, 0);
---
<BaseLayout title="归档" description="按月份归档的长文与笔记。">
  <PageHeader title="归档" subtitle="按月份归档的长文与笔记。" count={`共 ${totalPosts} 篇`} class="archive-page">
    {groups.map((g, gi) => (
      <section class="archive-group" data-reveal style={`--reveal-delay: ${Math.min(gi * 60, 240)}ms`}>
        <h2 class="archive-month">
          <span class="archive-month-label">{g.month}</span>
          <span class="archive-month-rule" aria-hidden="true" />
          <span class="archive-month-count">{g.items.length} 篇</span>
        </h2>
        <ul class="posts-list">
          {g.items.map((item, i) => (
            <li class="posts-item archive-item" data-reveal style={`--reveal-delay: ${i * 45}ms`}>
              <a class="archive-row" href={`/post/${item.slug}`}>
                <time class="archive-row-date" datetime={new Date(item.createdAt).toISOString()}>{fmtMonthDay(item.createdAt)}</time>
                <span class="archive-row-title">{item.title}</span>
                <span class="archive-row-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </PageHeader>
</BaseLayout>
