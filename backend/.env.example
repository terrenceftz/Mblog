# 服务端口
PORT=3000
# SQLite 文件路径（容器内）
DB_PATH=data/mblog.db
# 上传目录（容器内，与 nginx 共享卷）
UPLOAD_DIR=uploads
# JWT 密钥（必填，至少 32 位随机字符串，缺失或过短将拒绝启动）
JWT_SECRET=please-change-me-to-a-long-random-string
# 是否信任反向代理设置的真实 IP 头（x-forwarded-for / x-real-ip）。
# 仅当服务位于可信 Nginx/代理之后时设为 1，否则留空或设为 0
TRUST_PROXY=0
# 初始管理员（首次启动创建）
ADMIN_USERNAME=admin
# 初始管理员密码（生产环境必填，至少 8 位；非生产环境缺省回退 admin123）
ADMIN_PASSWORD=admin123
